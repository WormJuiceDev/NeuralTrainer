{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neural Trainer",
  "version": "0.1.0",
  "identifier": "com.codexfarm.neuraltrainer",
  "build": {
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Neural Trainer",
        "width": 1320,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
