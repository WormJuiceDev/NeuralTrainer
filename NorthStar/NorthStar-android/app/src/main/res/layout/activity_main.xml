<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B141A">

    <LinearLayout
        android:id="@+id/appShell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#202C33"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/topbarAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="#00A884"
                android:gravity="center"
                android:text="N"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/topbarTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#E9EDEF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/topbarSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/onboarding_copy"
                    android:textColor="#AEBAC1"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/topbarCallButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/call_short" />

            <Button
                android:id="@+id/topbarMenuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text="@string/menu_short" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111B21"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <Button
                    android:id="@+id/companionTabButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/companion_tab" />

                <Button
                    android:id="@+id/connectionTabButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/connection_tab" />
            </LinearLayout>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/companionSection"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ScrollView
                    android:id="@+id/messageThreadScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:id="@+id/messageThreadContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <LinearLayout
                    android:id="@+id/composerBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#111B21"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <EditText
                        android:id="@+id/messageDraftInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#202C33"
                        android:gravity="top|start"
                        android:hint="@string/message_hint"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minHeight="52dp"
                        android:padding="14dp"
                        android:textColor="#E9EDEF"
                        android:textColorHint="#AEBAC1" />

                    <Button
                        android:id="@+id/sendMessageButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/send_short" />
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/connectionSection"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:padding="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/versionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/native_version_label"
                        android:textColor="#AEBAC1" />

                    <TextView
                        android:id="@+id/onboardingText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/onboarding_copy"
                        android:textColor="#E9EDEF" />

                    <EditText
                        android:id="@+id/apiBaseInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="https://northstar.youworld.app"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:visibility="gone" />

                    <EditText
                        android:id="@+id/userHandleInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="savvy"
                        android:inputType="textNoSuggestions"
                        android:singleLine="true"
                        android:visibility="gone" />

                    <EditText
                        android:id="@+id/displayNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Savvy"
                        android:inputType="textPersonName"
                        android:singleLine="true"
                        android:visibility="gone" />

                    <EditText
                        android:id="@+id/desktopNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="DESKTOP-RONNY"
                        android:inputType="textNoSuggestions"
                        android:singleLine="true"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/pairButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/finish_setup" />

                    <Button
                        android:id="@+id/locationPermissionButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/allow_location" />

                    <Button
                        android:id="@+id/refreshButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/refresh_connection" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/status_waiting"
                        android:textColor="#E9EDEF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detailText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/detail_waiting"
                        android:textColor="#AEBAC1" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/callOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC081318"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/callOverlayPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/callOverlayAvatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="#00A884"
                android:gravity="center"
                android:text="N"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/callOverlayTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/call_overlay_title"
                android:textColor="#E9EDEF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/callOverlayStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/call_overlay_status"
                android:textColor="#E9EDEF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/callOverlayNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/call_transport_note"
                android:textColor="#AEBAC1" />

            <TextView
                android:id="@+id/callOverlayDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#17232A"
                android:padding="14dp"
                android:textColor="#AEBAC1"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/callVisualizer"
                android:layout_width="wrap_content"
                android:layout_height="132dp"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:id="@+id/callVisualizerBar1"
                    android:layout_width="18dp"
                    android:layout_height="84dp"
                    android:layout_marginHorizontal="5dp" />

                <View
                    android:id="@+id/callVisualizerBar2"
                    android:layout_width="18dp"
                    android:layout_height="112dp"
                    android:layout_marginHorizontal="5dp" />

                <View
                    android:id="@+id/callVisualizerBar3"
                    android:layout_width="18dp"
                    android:layout_height="128dp"
                    android:layout_marginHorizontal="5dp" />

                <View
                    android:id="@+id/callVisualizerBar4"
                    android:layout_width="18dp"
                    android:layout_height="112dp"
                    android:layout_marginHorizontal="5dp" />

                <View
                    android:id="@+id/callVisualizerBar5"
                    android:layout_width="18dp"
                    android:layout_height="84dp"
                    android:layout_marginHorizontal="5dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/callOverlayActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/callMicButton"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/mute_call"
                    android:padding="18dp"
                    android:src="@drawable/ic_call_mic"
                    android:visibility="gone" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/callDeclineButton"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/decline_call"
                    android:padding="24dp"
                    android:src="@drawable/ic_call_hangup" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/callAcceptButton"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/accept_call"
                    android:padding="24dp"
                    android:src="@drawable/ic_call_accept" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/callEndButton"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/end_call"
                    android:padding="24dp"
                    android:src="@drawable/ic_call_hangup"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
